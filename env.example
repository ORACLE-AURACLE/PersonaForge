# Copy to a local file (e.g. .env) and fill values

ENV=development
PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personaforge

DATABASE_URL=postgres://postgres:postgres@localhost:5432/personaforge?sslmode=disable

JWT_SECRET=change-me
JWT_EXPIRY_MINUTES=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GOOGLE_CLIENT_ID=


